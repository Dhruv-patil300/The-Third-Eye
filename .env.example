# ========================================================
# THE THIRD EYE — AI-Powered Investigation Intelligence
# Environment Configuration
# ========================================================

# Application Mode & Port
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# Supported providers: "local" (default deterministic offline engine), "gemini", "openai"
AI_PROVIDER=local

# Google Gemini API Key (Optional: for advanced generative extraction and assistant reasoning)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# Data Persistence Location (Defaults to local persistent JSON relational store at ./data/storage.json)
STORAGE_FILE_PATH=./data/storage.json
